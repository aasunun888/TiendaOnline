@model List<TiendaOnline.Entidades.Producto>


@if (Model == null || !Model.Any())
{
    <div class="text-center py-4">
        <p>No hay productos disponibles para el carrusel.</p>
    </div>
}
else
{
    <div class="carrusel-fullwidth">
        <div id="carouselMasVendidos" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <div class="d-flex carrusel-items">
                        @foreach (var p in Model)
                        {
                            var detallesUrl = Url.Action("Detalle", "Productos", new { area = "Publica", id = p.Id });
                            <a href="@detallesUrl" class="product-card-link text-decoration-none text-reset" aria-label="Ver detalles de @p.Nombre">
                                <div class="card carrusel-card text-center">
                                    <img src="@p.ImagenUrl" class="card-img-top" alt="@p.Nombre">
                                    <div class="card-body d-flex flex-column">
                                        <h6 class="card-title">@p.Nombre</h6>
                                    </div>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}
