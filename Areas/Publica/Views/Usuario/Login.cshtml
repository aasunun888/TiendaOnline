@using TiendaOnline.Areas.Publica.Models.UsuarioModels
@model LoginViewModel

@{
    ViewData["title"] = "Iniciar Sesión";

}
@section Styles {
    <link rel="stylesheet" href="~/css/Home/login.css" />
}
@section Scripts {
    <script src="~/js/Usuarios/ComprobarLogin.js" asp-append-version="true" defer></script>
}
<!--Section login-->
<div class="container-fluid body">

   
    <div class="container py-5 contenedor-login">
        <h2 class="text-center mb-4 ">Login</h2>
        @if (TempData["PerfilMensaje"] != null)
        {
            <div class="alert alert-success">@TempData["PerfilMensaje"]</div>
        }
        <!--Boton iniciar con Google TODO Implementar api GOOGLE-->
        <div class="d-grid gap-2 mb-3">
            <button class="btn btn-light border">
                <i class="fab fa-google me-2"></i> CONTINUAR CON GOOGLE
            </button>
        </div>

        <!-- Separador -->
        <div class="text-center my-3">
            <span class="text-muted">— O —</span>
        </div>

        <!-- Formulario -->
        <form action="/auth/login" method="post" id="loginForm" novalidate>
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="text" name="email" class="form-control" placeholder="Introduce tu email" required aria-describedby="emailError" />
                <span id="emailError" class="text-danger">@Model.emailComprobacion</span>
            </div>

            <div class="mb-3">
                <label class="form-label">Contraseña</label>
                <input type="password" name="contraseña" class="form-control" placeholder="Introduce tu contraseña" required aria-describedby="passError" />
                <span id="passError" class="text-danger">@Model.passComprobacion</span>
            </div>

            <span id="parametrosVacios" class="text-danger">@Model.parametrosVacios</span>

            <button type="submit" class="btn btn-dark w-100">INICIAR SESIÓN</button>
        </form>

        <!-- CTA para registro -->
        <div class="text-center mt-4">
            <span>
                ¿Aún no estás registrado?
                <a asp-area="Publica" asp-controller="Usuario" asp-action="RegistroView" class="text-decoration-none fw-bold">Crear cuenta</a>
            </span>
        </div>
    </div>
</div>
