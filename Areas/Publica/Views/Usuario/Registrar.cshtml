@using TiendaOnline.Areas.Publica.Models.UsuarioModels
@model LoginViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/Home/registro.css" />
}
@section Scripts {
    <script src="~/js/Usuarios/ComprobarRegistro.js" asp-append-version="true" defer></script>
}

<!--Section Registrar-->
<div class="container-fluid body">
    <div class="container py-5 contenedor-registro">
        <h2 class="text-center mb-4 ">Registrarse</h2>
        <form asp-area="Publica" asp-controller="Usuario" asp-action="RegistrarPost" method="post" id="registroForm" novalidate>
            <div class="row g-3">

                <!-- Nombre -->
                <div class="col-md-6">
                    <label class="form-label">Nombre</label>
                    <input type="text" name="Nombre" class="form-control" required aria-describedby="nombreError" />
                    <span id="nombreError" class="text-danger"></span>
                </div>
                <!-- Apellido -->
                <div class="col-md-6">
                    <label class="form-label">Apellido</label>
                    <input type="text" name="Apellido" class="form-control" required aria-describedby="apellidoError" />
                    <span id="apellidoError" class="text-danger"></span>
                </div>

                <!-- Email -->
                <div class="col-md-12">
                    <label class="form-label">Email</label>
                    <div class="input-group has-validation">
                        <span class="input-group-text">@@</span>
                        <input type="email" name="Email" class="form-control" required aria-describedby="emailError" />
                    </div>
                    <span id="emailError" class="text-danger">@Model.emailComprobacion</span>
                </div>

                <!-- Contraseña -->
                <div class="col-md-12">
                    <label class="form-label">Contraseña</label>
                    <input type="password" name="Contraseña" class="form-control" required aria-describedby="passError" />
                    <span id="passError" class="text-danger">@Model.passComprobacion</span>
                </div>

                <!-- Opcional -->
                <div class="text-center my-3">
                    <span class="text-muted">— Opcional —</span>
                </div>

                <!-- Teléfono -->
                <div class="col-md-6">
                    <label class="form-label">Teléfono</label>
                    <input type="text" name="Telefono" class="form-control" />
                </div>

                <!-- Dirección -->
                <div class="col-md-6">
                    <label class="form-label">Dirección</label>
                    <input type="text" name="Direccion" class="form-control"  />
                </div>

                <!-- Ciudad -->
                <div class="col-md-6">
                    <label class="form-label">Ciudad</label>
                    <input type="text" name="Ciudad" class="form-control"  />
                </div>

                <!-- Código Postal -->
                <div class="col-md-6">
                    <label class="form-label">Código Postal</label>
                    <input type="text" name="CodigoPostal" class="form-control"  />
                </div>

                <!-- Mensajes de validación generales -->
                <div class="col-12">
                    <span id="parametrosVacios" class="text-danger">@Model.parametrosVacios</span>
                    <span id="usuarioExistente" class="text-danger">@Model.usuarioExistente</span>
                </div>

                <!-- Botón de registro -->
                <div class="col-12 text-center mt-3">
                    <button class="btn btn-dark px-5" type="submit">Registrar</button>
                </div>
            </div>
        </form>
    </div>
</div>


