@using TiendaOnline.Areas.Publica.Models
@model HomeViewModel

@{
    ViewData["Titulo"] = "Home Page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Home/estiloHome.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Home/carrusel.css" asp-append-version="true" />
}

<!-- Section principal/portada-->
<section class="full-background d-flex align-items-center justify-content-center text-center text-white" style="background-image: url('@Model.ImagenUrl');">
    <div class="container">
        <h1 class="display-4 fw-bold">@Model.Titulo</h1>
        <p class="lead mb-4">
           @Model.Descripcion
        </p>
        <a asp-area="Publica" asp-controller="Productos" asp-action="Buscar" class="btn btn-dark btn-lg">IR A COMPRAR</a>
    </div>
</section>

<!--  TODO Section productos destacados-->
<h1 class="display-4 fw-bold text-center mt-5 mb-4">Productos más vendidos</h1>

<div id="carrusel-mas-vendidos-container"></div>

<script>
    (async function() {
        const container = document.getElementById('carrusel-mas-vendidos-container');
        try {
            const res = await fetch('@Url.Action("ProductosMasVendidos", "Home", new { area = "Publica" })', { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            if (res.ok) {
                const html = await res.text();
                container.innerHTML = html;
            } else {
                console.error('No se pudo cargar el carrusel: ', res.status);
            }
        } catch (err) {
            console.error('Error al cargar carrusel:', err);
        }
    })();
</script>



