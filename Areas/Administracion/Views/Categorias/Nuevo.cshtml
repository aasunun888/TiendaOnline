@model TiendaOnline.Areas.Administracion.Models.CategoriaCreacionViewModel

@{
    Layout = "~/Areas/Publica/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Nueva categoría";
}
<div class="container mt-4">
    <div class="card">
        <div class="card-header"><strong>Nueva categoría</strong></div>
        <div class="card-body">
            <form asp-area="Administracion" asp-controller="Categorias" asp-action="Nuevo" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label">Nombre</label>
                    <input class="form-control" name="Nombre" value="@Model.Nombre" />
                </div>
                <button class="btn btn-dark" type="submit">Crear categoría</button>
                <a class="btn btn-outline-secondary ms-2" asp-area="Administracion" asp-controller="Dashboard" asp-action="Index">Cancelar</a>
            </form>
        </div>
    </div>
</div>